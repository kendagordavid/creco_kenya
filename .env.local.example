# Use built-in /api routes on Vercel (leave empty).
# Optional: http://localhost:8000 when running prototype/backend locally
# NEXT_PUBLIC_API_URL=

# Required for sign-in sessions — MUST be set on Vercel Production + Preview.
# Without it, login appears to work but the session is lost on the next page.
# Generate once: openssl rand -base64 32 — do not rotate on a live site or
# every signed-in user will be logged out.
AUTH_SECRET=
#
# Optional on Vercel (trustHost is enabled). Set for custom domains if needed:
# AUTH_URL=https://your-domain.example

# Google OAuth — optional; enables "Sign in with Google" on /login
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (production): https://creco-kenya.vercel.app/api/auth/callback/google
# Paste real values into .env.local (local) and Vercel env vars (production) — not this file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Postgres — required for users, submissions, and feedback persistence.
# Local example (create DB first: createdb creco_pbo):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/creco_pbo
#
# Vercel + Neon: copy POSTGRES_URL from Vercel → Storage → Neon → .env.local
# Use the pooled connection string for the app; run db:setup with the direct URL if needed.

# Optional: OpenAI key for polished guidance answers
# OPENAI_API_KEY=
