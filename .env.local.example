# Use built-in /api routes on Vercel (leave empty).
# Optional: http://localhost:8000 when running prototype/backend locally
# NEXT_PUBLIC_API_URL=

# Required for sign-in sessions — MUST be set on Vercel Production + Preview.
# Without it, login appears to work but the session is lost on the next page.
# Generate once: openssl rand -base64 32 — do not rotate on a live site or
# every signed-in user will be logged out.
AUTH_SECRET=
#
# Optional on Vercel (trustHost is enabled). Set for custom domains if needed:
# AUTH_URL=https://your-domain.example

# Google OAuth — optional; enables "Sign in with Google" on /login
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (production): https://creco-kenya.vercel.app/api/auth/callback/google
# Paste real values into .env.local (local) and Vercel env vars (production) — not this file.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Postgres — required for users, submissions, and feedback persistence.
# Local example (create DB first: createdb creco_pbo):
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/creco_pbo
#
# Vercel + Neon: copy POSTGRES_URL from Vercel → Storage → Neon → .env.local
# Use the pooled connection string for the app; run db:setup with the direct URL if needed.

# Optional: OpenAI key for polished guidance answers and/or topic read-aloud (see OPENAI_TTS_MODEL).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Ask a Question also uses OpenRouter when OPENROUTER_API_KEY (or OPENROUTER_TTS_API_KEY) is set.
# OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini

# Topic read-aloud via OpenRouter (preferred if you use OpenRouter). The key stays on the server.
# Restart the dev server after changing env vars. Set the same names in Vercel → Environment Variables.
# OPENROUTER_API_KEY=   (alias: OPENROUTER_TTS_API_KEY)
# Optional. Defaults to Gemini 3.8 Flash TTS with the clear "Iapetus" voice, read slowly.
# The account needs OpenRouter credits, otherwise the site falls back to the browser voice.
# OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
# OPENROUTER_TTS_VOICE=Iapetus   (other clear Gemini voices: Erinome, Charon, Schedar)
# A voice from another model family (e.g. coral) is ignored for Gemini.

# News & Updates emails (optional). Visitors can subscribe on /news; when staff publish a post,
# subscribers are emailed through Resend (https://resend.com). Verify your sending domain there first.
# Without these, sign-ups are still saved and emails start once the keys are set.
# RESEND_API_KEY=
# NEWS_EMAIL_FROM=Mashirika Law <updates@your-domain.org>
# SITE_URL=https://your-domain.org   (used for links in emails; defaults to the request's host)
